{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if ! python3 \"${PLUGIN_ROOT}/scripts/bridge.py\" stop >/dev/null 2>&1; then printf '%s\\n' 'MindIE Stop capture failed before completion; inspect MindIE status.' >&2; fi; printf '{}\\n'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
