{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "if ! python3 \"${PLUGIN_ROOT}\"/scripts/bridge.py stop >/dev/null 2>&1; then printf '%s\\n' 'MindIE Stop helper failed; capture completion is unconfirmed; no automatic retry.' >&2; fi; printf '{}\\n'",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
          }
        ]
      }
    ]
  }
}
