            "command": "if ! uv --native-tls run --no-project --python 3.13 python -B -c 'import os,sys,json,re,runpy\nfrom pathlib import Path\ndef read(p):\n if not p.is_file():raise ValueError('\"'\"'MindIE metadata must be regular'\"'\"')\n with p.open('\"'\"'rb'\"'\"') as f:\n  raw=f.read(65537)\n if len(raw)>65536:raise ValueError('\"'\"'MindIE metadata exceeds its byte bound'\"'\"')\n value=json.loads(raw)\n if not isinstance(value,dict):raise ValueError('\"'\"'MindIE metadata must be an object'\"'\"')\n return value\nhome=Path(os.environ.get('\"'\"'CODEX_HOME'\"'\"',str(Path.home()/'\"'\"'.codex'\"'\"')))\ndata=Path(os.environ.get('\"'\"'PLUGIN_DATA'\"'\"',str(home/'\"'\"'plugins/data'\"'\"'/'\"'\"'mindie-agent-mindie-agent'\"'\"')))\nconfig=Path(os.environ.get('\"'\"'MINDIE_AGENT_CONFIG'\"'\"',str(Path.home()/'\"'\"'.config/mindie-agent/codex.json'\"'\"'))).expanduser().absolute()\nargs=sys.argv[1:]\nif config.exists():\n adapter=read(config);validation=adapter['\"'\"'product_validation'\"'\"'];version=validation['\"'\"'native_version'\"'\"']\n if not isinstance(version,str) or not re.fullmatch('\"'\"'[0-9A-Za-z][0-9A-Za-z.+!-]{0,79}'\"'\"',version):raise ValueError('\"'\"'MindIE release identity is invalid'\"'\"')\n release=Path(adapter['\"'\"'component_release'\"'\"']) if adapter.get('\"'\"'component_release'\"'\"') else data/'\"'\"'releases'\"'\"'/version\n receipt=read(release/'\"'\"'runtime.json'\"'\"');entry=release/'\"'\"'entry.py'\"'\"'\n if receipt['\"'\"'python'\"'\"']!=adapter['\"'\"'python'\"'\"'] or receipt['\"'\"'validation'\"'\"']!=validation or validation.get('\"'\"'status'\"'\"')!='\"'\"'validated'\"'\"' or validation.get('\"'\"'schema'\"'\"')!='\"'\"'mindie-candidate-check/1'\"'\"':raise ValueError('\"'\"'MindIE installed runtime receipt differs'\"'\"')\nelse:\n seed=None;fixed=data/'\"'\"'releases'\"'\"'/seed/'\"'\"'entry.py'\"'\"' if seed else None\n if fixed is not None and fixed.is_file():entry=fixed\n else:\n  if args[:1]==['\"'\"'stop'\"'\"']:raise RuntimeError('\"'\"'MindIE runtime is not prepared; start a new native session'\"'\"')\n  source=Path(os.environ.get('\"'\"'PLUGIN_ROOT'\"'\"',str(home/'\"'\"'plugins/cache'\"'\"'/'\"'\"'mindie-agent'\"'\"'/'\"'\"'mindie-agent'\"'\"'/(seed or '\"'\"'unprepared'\"'\"'))))\n  entry=source/'\"'\"'scripts/bootstrap.py'\"'\"';args=[str(data),'\"'\"'--source'\"'\"',str(source),*args]\nif not entry.is_file():raise RuntimeError('\"'\"'MindIE installed entry is unavailable'\"'\"')\nsys.path.insert(0,str(entry.parent));sys.argv=[str(entry),*args]\nrunpy.run_path(str(entry),run_name='\"'\"'__main__'\"'\"')' session-start >/dev/null; then printf '%s\\n' 'MindIE session preparation failed; inspect the reported stage and local diagnostics; no automatic retry.' >&2; printf '%s\\n' '{\"systemMessage\": \"MindIE session preparation failed; inspect the reported stage and local diagnostics; no automatic retry.\"}'; else printf '{}\\n'; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand "
