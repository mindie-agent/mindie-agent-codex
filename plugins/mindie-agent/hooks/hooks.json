            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "if ! uv run --no-project --python 3.13 python -c 'import os,sys,json,stat,re,runpy\nfrom pathlib import Path\ndef read(p):\n if p.is_symlink():raise ValueError('\"'\"'MindIE metadata must be regular'\"'\"')\n with os.fdopen(os.open(p,os.O_RDONLY|getattr(os,'\"'\"'O_NONBLOCK'\"'\"',0)|getattr(os,'\"'\"'O_NOFOLLOW'\"'\"',0)),'\"'\"'rb'\"'\"') as f:\n  if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):raise ValueError('\"'\"'MindIE metadata must be regular'\"'\"')\n  raw=f.read(65537)\n if len(raw)>65536:raise ValueError('\"'\"'MindIE metadata exceeds its byte bound'\"'\"')\n value=json.loads(raw)\n if not isinstance(value,dict):raise ValueError('\"'\"'MindIE metadata must be an object'\"'\"')\n return value\nhome=Path(os.environ.get('\"'\"'CODEX_HOME'\"'\"',str(Path.home()/'\"'\"'.codex'\"'\"')))\ndata=Path(os.environ.get('\"'\"'PLUGIN_DATA'\"'\"',str(home/'\"'\"'plugins/data'\"'\"'/'\"'\"'mindie-agent-mindie-agent'\"'\"')))\nconfig=Path(os.environ.get('\"'\"'MINDIE_AGENT_CONFIG'\"'\"',str(Path.home()/'\"'\"'.config/mindie-agent/codex.json'\"'\"'))).expanduser().absolute()\nargs=sys.argv[1:]\nif os.path.lexists(config):\n adapter=read(config);validation=adapter['\"'\"'product_validation'\"'\"'];version=validation['\"'\"'native_version'\"'\"']\n if not isinstance(version,str) or not re.fullmatch('\"'\"'[0-9A-Za-z][0-9A-Za-z.+!-]{0,79}'\"'\"',version):raise ValueError('\"'\"'MindIE release identity is invalid'\"'\"')\n release=data/'\"'\"'releases'\"'\"'/version;receipt=read(release/'\"'\"'runtime.json'\"'\"');entry=release/'\"'\"'entry.py'\"'\"'\n if receipt['\"'\"'python'\"'\"']!=adapter['\"'\"'python'\"'\"'] or receipt['\"'\"'validation'\"'\"']!=validation or validation.get('\"'\"'status'\"'\"')!='\"'\"'validated'\"'\"' or validation.get('\"'\"'schema'\"'\"')!='\"'\"'mindie-candidate-check/1'\"'\"':raise ValueError('\"'\"'MindIE installed runtime receipt differs'\"'\"')\nelse:\n if args[:1]==['\"'\"'stop'\"'\"']:raise RuntimeError('\"'\"'MindI