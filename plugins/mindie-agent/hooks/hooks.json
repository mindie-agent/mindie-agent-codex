{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "uv --native-tls run --no-project --python 3.13 python -B \"${PLUGIN_ROOT}\"/scripts/hook_launcher.py session-start >/dev/null; _st=$?; if [ \"$_st\" -ne 0 ]; then printf '%s\\n' 'MindIE session preparation failed; inspect the reported stage and local diagnostics; no automatic retry.' >&2; printf '%s\\n' '{\"systemMessage\": \"MindIE session preparation failed; inspect the reported stage and local diagnostics; no automatic retry. (exit '\"$_st\"')\"}'; exit \"$_st\"; else printf '{}\\n'; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 1320
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "uv --native-tls run --no-project --offline --no-python-downloads --python 3.13 python -B \"${PLUGIN_ROOT}\"/scripts/hook_launcher.py user-prompt-submit",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 1440
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "_err=$(mktemp) || exit 1; uv --native-tls run --no-project --offline --no-python-downloads --python 3.13 python -B \"${PLUGIN_ROOT}\"/scripts/hook_launcher.py stop >/dev/null 2>\"$_err\"; _st=$?; if [ \"$_st\" -ne 0 ]; then cat \"$_err\" >&2; rm -f \"$_err\"; printf '%s\\n' '{\"systemMessage\": \"MindIE Stop helper failed; capture completion is unconfirmed; no automatic retry. (exit '\"$_st\"')\"}'; else rm -f \"$_err\"; printf '{}\\n'; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 240
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "mindie-remote-dev",
            "tool": "mindie_interrupt",
            "input": {
              "thread_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 3,
            "statusMessage": "MindIE cancellation"
          },
          {
            "type": "mcp_tool",
            "server": "mindie-tools",
            "tool": "mindie_interrupt",
            "input": {
              "thread_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 3,
            "statusMessage": "MindIE cancellation"
          }
        ]
      }
    ]
  }
}
