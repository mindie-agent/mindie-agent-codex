{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "_hl=\"${PLUGIN_ROOT}/scripts/hook_launcher.py\"; if [ ! -f \"$_hl\" ]; then _hl=\"${PLUGIN_DATA}/hook_launcher.py\"; fi; uv --native-tls run --no-project --python 3.13 python -B \"$_hl\" session-start >/dev/null; _st=$?; if [ \"$_st\" -ne 0 ]; then printf '%s\\n' 'MindIE session preparation failed; inspect the reported stage and local diagnostics; no automatic retry.' >&2; printf '%s\\n' '{\"systemMessage\": \"MindIE session preparation failed; inspect the reported stage and local diagnostics; no automatic retry. (exit '\"$_st\"')\"}'; exit \"$_st\"; else printf '{}\\n'; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 1545
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "_hl=\"${PLUGIN_ROOT}/scripts/hook_launcher.py\"; if [ ! -f \"$_hl\" ]; then _hl=\"${PLUGIN_DATA}/hook_launcher.py\"; fi; uv --native-tls run --no-project --offline --no-python-downloads --python 3.13 python -B \"$_hl\" user-prompt-submit",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 1440
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "_hl=\"${PLUGIN_ROOT}/scripts/hook_launcher.py\"; if [ ! -f \"$_hl\" ]; then _hl=\"${PLUGIN_DATA}/hook_launcher.py\"; fi; _err=$(mktemp) || exit 1; uv --native-tls run --no-project --offline --no-python-downloads --python 3.13 python -B \"$_hl\" stop >/dev/null 2>\"$_err\"; _st=$?; if [ \"$_st\" -ne 0 ]; then cat \"$_err\" >&2; python3 -c 'import json,pathlib,sys\nst,path,prefix=sys.argv[1],sys.argv[2],sys.argv[3]\nerr=pathlib.Path(path).read_text(encoding='\"'\"'utf-8'\"'\"',errors='\"'\"'replace'\"'\"')[:800].strip()\nmsg=prefix+'\"'\"' (exit '\"'\"'+st+'\"'\"')'\"'\"'\nprint(json.dumps({'\"'\"'systemMessage'\"'\"':(msg+chr(10)+err) if err else msg}))\n' \"$_st\" \"$_err\" 'MindIE Stop helper failed; capture completion is unconfirmed; no automatic retry.' || printf '%s\\n' '{\"systemMessage\": \"MindIE Stop helper failed; capture completion is unconfirmed; no automatic retry. (exit '\"$_st\"')\"}'; rm -f \"$_err\"; else rm -f \"$_err\"; printf '{}\\n'; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 240
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "mindie-remote-dev",
            "tool": "mindie_interrupt",
            "input": {
              "thread_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 3,
            "statusMessage": "MindIE cancellation"
          },
          {
            "type": "mcp_tool",
            "server": "mindie-tools",
            "tool": "mindie_interrupt",
            "input": {
              "thread_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 3,
            "statusMessage": "MindIE cancellation"
          }
        ]
      }
    ]
  }
}
