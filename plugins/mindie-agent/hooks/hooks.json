{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "_hl=\"$PLUGIN_ROOT/scripts/hook_launcher.py\"; if [ ! -f \"$_hl\" ]; then _hl=\"$PLUGIN_DATA/hook_launcher.py\"; fi; uv --native-tls run --no-project --python 3.13 python -B \"$_hl\" session-start >/dev/null; _st=$?; if [ \"$_st\" -ne 0 ]; then printf '%s\\n' 'MindIE session preparation failed; inspect the reported stage and local diagnostics; no automatic retry.' >&2; printf '%s\\n' '{\"systemMessage\": \"MindIE session preparation failed; inspect the reported stage and local diagnostics; no automatic retry. (exit '\"$_st\"')\"}'; exit \"$_st\"; else printf '{}\\n'; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 1545
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "_hl=\"$PLUGIN_ROOT/scripts/hook_launcher.py\"; if [ ! -f \"$_hl\" ]; then _hl=\"$PLUGIN_DATA/hook_launcher.py\"; fi; _in=$(head -c33554433; printf x); _in=${_in%x}; _out=$(printf '%s' \"$_in\" | uv --native-tls run --no-project --offline --no-python-downloads --python 3.13 python -B \"$_hl\" user-prompt-submit); _st=$?; if [ \"$_st\" -eq 0 ]; then if [ -n \"$_out\" ]; then printf '%s\\n' \"$_out\"; else printf '{}\\n'; fi; elif printf '%s' \"$_in\" | LC_ALL=C grep -Eq '(^|[{,][[:space:]]*)\"hook_event_name\"[[:space:]]*:[[:space:]]*\"UserPromptSubmit\"' && printf '%s' \"$_in\" | LC_ALL=C grep -Eq '(^|[{,][[:space:]]*)\"prompt\"[[:space:]]*:[[:space:]]*\"(([[:space:]]|\u001c|\u001d|\u001e|\u001f|\\\\[fnrt]|\\\\u00(0[9a-dA-D]|1[c-fC-F]|20)|\u0085|\u00a0|\u1680|\u2000|\u2001|\u2002|\u2003|\u2004|\u2005|\u2006|\u2007|\u2008|\u2009|\u200a|\u2028|\u2029|\u202f|\u205f|\u3000|\\\\u0085|\\\\u0085|\\\\u00a0|\\\\u00A0|\\\\u1680|\\\\u1680|\\\\u2000|\\\\u2000|\\\\u2001|\\\\u2001|\\\\u2002|\\\\u2002|\\\\u2003|\\\\u2003|\\\\u2004|\\\\u2004|\\\\u2005|\\\\u2005|\\\\u2006|\\\\u2006|\\\\u2007|\\\\u2007|\\\\u2008|\\\\u2008|\\\\u2009|\\\\u2009|\\\\u200a|\\\\u200A|\\\\u2028|\\\\u2028|\\\\u2029|\\\\u2029|\\\\u202f|\\\\u202F|\\\\u205f|\\\\u205F|\\\\u3000|\\\\u3000)|\ufeff|\\\\u[fF][eE][fF][fF])*(/mindie-agent|\\$mindie-agent(:mindie-agent)?|\\[\\$mindie-agent(:mindie-agent)?\\]\\(([^\"\\\\)]|\\\\[^nr])+\\)|\\[@mindie-agent\\]\\(plugin://mindie-agent@([^\"\\\\)]|\\\\[^nr])+\\))(\"|([[:space:]]|\u001c|\u001d|\u001e|\u001f|\\\\[fnrt]|\\\\u00(0[9a-dA-D]|1[c-fC-F]|20)|\u0085|\u00a0|\u1680|\u2000|\u2001|\u2002|\u2003|\u2004|\u2005|\u2006|\u2007|\u2008|\u2009|\u200a|\u2028|\u2029|\u202f|\u205f|\u3000|\\\\u0085|\\\\u0085|\\\\u00a0|\\\\u00A0|\\\\u1680|\\\\u1680|\\\\u2000|\\\\u2000|\\\\u2001|\\\\u2001|\\\\u2002|\\\\u2002|\\\\u2003|\\\\u2003|\\\\u2004|\\\\u2004|\\\\u2005|\\\\u2005|\\\\u2006|\\\\u2006|\\\\u2007|\\\\u2007|\\\\u2008|\\\\u2008|\\\\u2009|\\\\u2009|\\\\u200a|\\\\u200A|\\\\u2028|\\\\u2028|\\\\u2029|\\\\u2029|\\\\u202f|\\\\u202F|\\\\u205f|\\\\u205F|\\\\u3000|\\\\u3000))' && ! printf '%s' \"$_in\" | LC_ALL=C grep -Eq '(^|[{,][[:space:]]*)\"agent_id\"[[:space:]]*:[[:space:]]*\"[^\"]'; then printf '%s\\n' '{\"systemMessage\": \"MindIE UserPromptSubmit launcher failed; inspect local diagnostics and do not repeat /mindie-agent in a loop. (exit '\"$_st\"')\"}'; else printf '{}\\n'; fi; exit 0",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 1665
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "MindIE Agent",
            "command": "_hl=\"$PLUGIN_ROOT/scripts/hook_launcher.py\"; if [ ! -f \"$_hl\" ]; then _hl=\"$PLUGIN_DATA/hook_launcher.py\"; fi; _err=$(mktemp) || exit 1; uv --native-tls run --no-project --offline --no-python-downloads --python 3.13 python -B \"$_hl\" stop >/dev/null 2>\"$_err\"; _st=$?; if [ \"$_st\" -ne 0 ] || [ -s \"$_err\" ]; then cat \"$_err\" >&2; python3 -c 'import json,pathlib,sys;st,path,prefix=sys.argv[1],sys.argv[2],sys.argv[3];err=pathlib.Path(path).read_text(encoding=\"utf-8\",errors=\"replace\")[:800].strip();msg=prefix+\" (exit \"+st+\")\";print(json.dumps({\"systemMessage\":(msg+chr(10)+err) if err else msg}))' \"$_st\" \"$_err\" 'MindIE Stop helper failed; capture completion is unconfirmed; no automatic retry.' || printf '%s\\n' '{\"systemMessage\": \"MindIE Stop helper failed; capture completion is unconfirmed; no automatic retry. (exit '\"$_st\"')\"}'; rm -f \"$_err\"; else rm -f \"$_err\"; printf '{}\\n'; fi",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 240
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "mindie-remote-dev",
            "tool": "mindie_interrupt",
            "input": {
              "thread_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 3,
            "statusMessage": "MindIE cancellation"
          },
          {
            "type": "mcp_tool",
            "server": "mindie-tools",
            "tool": "mindie_interrupt",
            "input": {
              "thread_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 3,
            "statusMessage": "MindIE cancellation"
          }
        ]
      }
    ]
  }
}
